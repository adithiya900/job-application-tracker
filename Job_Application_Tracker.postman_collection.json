		{
			"name": "Day 9 - Job Search (Adzuna API)",
			"item": [
				{
					"name": "Search Jobs",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var json = pm.response.json();",
									"",
									"pm.test('Response has jobs array', function () {",
									"    pm.expect(json).to.have.property('jobs');",
									"    pm.expect(json.jobs).to.be.an('array');",
									"});",
									"",
									"pm.test('Response has cached field', function () {",
									"    pm.expect(json).to.have.property('cached');",
									"});",
									"",
									"pm.test('Response has source field', function () {",
									"    pm.expect(json).to.have.property('source');",
									"    pm.expect(['cache', 'api']).to.include(json.source);",
									"});",
									"",
									"pm.test('Response has count field', function () {",
									"    pm.expect(json).to.have.property('count');",
									"});",
									"",
									"if (json.jobs.length > 0) {",
									"    var job = json.jobs[0];",
									"    pm.test('First job has title', function () {",
									"        pm.expect(job).to.have.property('title');",
									"    });",
									"    pm.test('First job has company', function () {",
									"        pm.expect(job).to.have.property('company');",
									"    });",
									"    pm.test('First job has salary_range', function () {",
									"        pm.expect(job).to.have.property('salary_range');",
									"    });",
									"    pm.test('First job has redirect_url', function () {",
									"        pm.expect(job).to.have.property('redirect_url');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
