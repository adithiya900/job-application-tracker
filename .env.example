# Docker Compose builds the internal database URL from POSTGRES_PASSWORD.
# Do not put credentials in this example file; set real values in .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Local-only demo login credentials; change these before seeding outside development.
DEMO_USER_EMAIL=user@gmail.com
DEMO_USER_PASSWORD=user123
DEMO_HR_EMAIL=hr@gmail.com
DEMO_HR_PASSWORD=hr123
DEMO_ADMIN_EMAIL=admin@gmail.com
DEMO_ADMIN_PASSWORD=admin123
# These localhost values are only for non-Docker tooling; Compose overrides
# DATABASE_URL and REDIS_URL with service names.
DATABASE_URL=postgresql://job_tracker:replace-with-a-long-random-password@localhost:5432/job_tracker
REDIS_URL=redis://localhost:6379/0
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
SCHEDULER_ENABLED=true
WEBHOOK_URL=
WEBHOOK_SECRET=
